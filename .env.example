# Copy to .env, chmod 600, and fill in. Never commit .env.
# With docker compose (env_file), wrap values containing $ in single quotes, or compose replaces $WORDS with
# blanks. This matters for ALERT_WEBHOOK_TEMPLATE and for passwords. `setup` writes single-quoted values.

# --- Lillio ---
# Portal host. Daycare chains that white-label Lillio use their own host; use whatever you log in at.
LILLIO_BASE_URL=https://app.lillio.com
# Either email/password (preferred: survives session expiry) ...
LILLIO_EMAIL=
LILLIO_PASSWORD=
# ... or a session cookie copied from the browser: name=value, or a bare value for _himama_session
# LILLIO_SESSION_COOKIE=
# Child account ids, comma separated. Optional: discovered automatically (see `lillio-immich-sync children`)
# LILLIO_CHILD_IDS=

# --- Immich ---
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=
# Optional album; {child} becomes the child's name. Created if missing.
# IMMICH_ALBUM=Daycare - {child}
# More albums every item also goes into, separated by ;. A name, or an existing album's id or URL
# IMMICH_EXTRA_ALBUMS=Family
# IMMICH_EXTRA_ALBUMS=https://immich.example.com/albums/11111111-2222-4333-8444-555555555555
# Set 0 to never create albums (a missing album then stops the run)
# IMMICH_CREATE_ALBUMS=1

# --- Behaviour ---
# Your local zone: used for the schedule and for portal timestamps without an offset
# TIMEZONE=America/New_York
# Schedule for the `daemon` command (local times; days: daily, weekdays, weekends, mon-fri, mon,wed,fri)
# SYNC_TIMES=18:00
# SYNC_DAYS=daily
# SYNC_VIDEOS=1
# Ignore anything older than this date
# SYNC_SINCE=2025-09-01
# STATE_DIR=./state

# --- Alerts (all optional; see docs/alerting.md) ---
# Slack-style webhook (default template): {"text": "$MESSAGE"}
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/XXX
# Discord-style:
# ALERT_WEBHOOK_TEMPLATE='{"content": "$MESSAGE"}'
# Or any command; message on stdin, kind in $ALERT_KIND:
# ALERT_COMMAND=/usr/local/bin/my-notify
# Alert when no new journal items have appeared for this many days (0 = off). Allow for weekends and holidays.
# STALE_ALERT_DAYS=5
